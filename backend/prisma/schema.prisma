// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  RECEPTIONIST
  PATIENT
  PHARMACY
  PATHOLOGY
  REFERRAL
}

enum TenantType {
  HOSPITAL
  PHARMACY
  PATHOLOGY
}

enum SubscriptionPlan {
  FREE
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

// Mirrors Razorpay subscription statuses (created, authenticated, active,
// pending, halted, cancelled, completed, expired), folding "authenticated"
// into CREATED until the first charge succeeds.
enum SubscriptionStatus {
  CREATED
  ACTIVE
  PENDING
  HALTED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum ReportType {
  BLOOD_TEST
  XRAY
  MRI
  CT_SCAN
  ULTRASOUND
  ECG
  PRESCRIPTION
  LAB_REPORT
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

enum TimelineEventType {
  APPOINTMENT
  PRESCRIPTION
  MEDICINE_STARTED
  REPORT_UPLOADED
  FOLLOW_UP
  REMINDER_SENT
  NOTE_ADDED
  LAB_ORDER_PLACED
  LAB_REPORT_READY
}

// ─────────────────────────────────────────
// PHARMACY OPERATIONS ENUMS
// ─────────────────────────────────────────

enum BatchStatus {
  ACTIVE
  BLOCKED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PharmacyPrescriptionStatus {
  PENDING
  VERIFIED
  DISPENSED
  PARTIALLY_DISPENSED
  CANCELLED
}

enum DispenseStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  SALE
  DISPENSE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum ReturnType {
  CUSTOMER
  SUPPLIER
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// ─────────────────────────────────────────
// PATHOLOGY OPERATIONS ENUMS
// ─────────────────────────────────────────

enum LabLinkStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_SCHEDULED
  SAMPLE_COLLECTED
  RECEIVED_AT_LAB
  ACCEPTED
  SAMPLE_REJECTED
  RECOLLECTION_REQUESTED
  IN_PROGRESS
  RESULT_READY
  PENDING_VERIFICATION
  VERIFIED
  REPORT_DELIVERED
  CANCELLED
}

enum LabOrderItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CollectionType {
  WALK_IN
  HOME
}

// Reasons a received sample can be rejected before it enters processing.
enum SampleRejectionReason {
  INSUFFICIENT_SAMPLE
  WRONG_CONTAINER
  HEMOLYZED
  SAMPLE_EXPIRED
  CONTAMINATED
  OTHER
}

// Auto-computed at result-entry time from LabTestParameterDef's normal/
// critical ranges when possible; CRITICAL always wins over LOW/HIGH/ABNORMAL.
enum ResultFlag {
  NORMAL
  LOW
  HIGH
  ABNORMAL
  CRITICAL
}

// How a parameter's value should be captured/rendered.
enum ResultValueType {
  NUMERIC
  TEXT
  DROPDOWN
  POSITIVE_NEGATIVE
  REACTIVE_NONREACTIVE
  NORMAL_ABNORMAL
}

// Mirrors FHIR DiagnosticReport status semantics (preliminary/final/amended).
enum LabReportStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  AMENDED
  DELIVERED
}

// ─────────────────────────────────────────
// TENANT (Hospital / Clinic)
// ─────────────────────────────────────────

model Tenant {
  id                 String           @id @default(cuid())
  type               TenantType       @default(HOSPITAL)
  name               String
  slug               String           @unique
  email              String
  phone              String?
  address            String?
  city               String?
  state              String?
  country            String?          @default("India")
  logoUrl            String?
  website            String?
  licenseNumber      String?
  subscriptionPlan   SubscriptionPlan @default(FREE)
  subscriptionEndsAt DateTime?
  isActive           Boolean          @default(true)
  referredById       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  users                   User[]
  departments             Department[]
  patients                Patient[]
  appointments            Appointment[]
  reports                 Report[]
  invoices                Invoice[]
  invites                 HospitalInvite[]
  medicalCatalogItems     MedicalCatalogItem[]
  pharmacies              Pharmacy[]
  pharmacyInvites         PharmacyInvite[]
  pathologyLabs           PathologyLab[]
  pathologyLabInvitesSent PathologyLabInvite[]
  hospitalLabLinks        HospitalLabLink[]
  labOrders               LabOrder[]
  subscriptions           Subscription[]
  referredBy              Referral?            @relation("TenantReferredBy", fields: [referredById], references: [id])
  referralCommissions     ReferralCommission[]

  @@map("tenants")
}

// ─────────────────────────────────────────
// SAAS SUBSCRIPTION BILLING (Razorpay)
// ─────────────────────────────────────────

model Plan {
  id             String           @id @default(cuid())
  tier           SubscriptionPlan
  billingCycle   BillingCycle
  name           String
  priceInPaise   Int // Razorpay amounts are integer paise, not Decimal rupees
  currency       String           @default("INR")
  razorpayPlanId String?          @unique // null for the FREE tier (no gateway plan)
  features       Json
  maxDoctors     Int? // nullable = unlimited
  maxPatients    Int?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  subscriptions Subscription[]

  @@unique([tier, billingCycle])
  @@map("plans")
}

model Subscription {
  id                     String             @id @default(cuid())
  tenantId               String
  planId                 String
  razorpaySubscriptionId String?            @unique
  razorpayCustomerId     String?
  status                 SubscriptionStatus @default(CREATED)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  shortUrl               String?
  notes                  Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  plan                Plan                 @relation(fields: [planId], references: [id])
  referralCommissions ReferralCommission[]

  @@index([tenantId])
  @@map("subscriptions")
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @default("razorpay")
  eventId     String    @unique
  eventType   String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@map("webhook_events")
}

// ─────────────────────────────────────────
// USER
// ─────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  tenantId     String?
  email        String    @unique
  phone        String?   @unique
  passwordHash String?
  firstName    String
  lastName     String
  role         UserRole  @default(PATIENT)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  isVerified   Boolean   @default(false)
  googleId     String?   @unique
  refreshToken String?
  otp          String?
  otpExpiresAt DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  whatsappOptIn   Boolean   @default(false)
  whatsappOptInAt DateTime?

  tenant                  Tenant?              @relation(fields: [tenantId], references: [id])
  doctor                  Doctor?
  patient                 Patient?
  pharmacy                Pharmacy?
  pathologyLab            PathologyLab?
  referral                Referral?
  sentMessages            Message[]            @relation("SentMessages")
  notifications           Notification[]
  whatsappMessageLogs     WhatsappMessageLog[]
  referralPayoutsRecorded ReferralPayout[]

  @@map("users")
}

model WhatsappMessageLog {
  id           String                @id @default(cuid())
  userId       String?
  toPhone      String
  templateName String
  waMessageId  String?               @unique
  status       WhatsappMessageStatus @default(QUEUED)
  errorMessage String?
  metadata     Json?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@map("whatsapp_message_logs")
}

enum WhatsappMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

// ─────────────────────────────────────────
// EMAIL REGISTRATION CHALLENGE (pre-user OTP)
// ─────────────────────────────────────────

model EmailRegistrationChallenge {
  id           String    @id @default(cuid())
  email        String    @unique
  otpHash      String
  expiresAt    DateTime
  attemptCount Int       @default(0)
  verifiedAt   DateTime?
  consumedAt   DateTime?
  lastSentAt   DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("email_registration_challenges")
}

// ─────────────────────────────────────────
// HOSPITAL INVITE
// ─────────────────────────────────────────

model HospitalInvite {
  id        String    @id @default(cuid())
  tenantId  String
  email     String
  role      UserRole
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("hospital_invites")
}

// ─────────────────────────────────────────
// DEPARTMENT
// ─────────────────────────────────────────

model Department {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  doctors Doctor[]

  @@map("departments")
}

// ─────────────────────────────────────────
// DOCTOR
// ─────────────────────────────────────────

model Doctor {
  id                String   @id @default(cuid())
  userId            String   @unique
  tenantId          String
  departmentId      String?
  specialization    String
  qualification     String?
  registrationNo    String?
  experienceYears   Int?
  consultationFee   Decimal? @db.Decimal(10, 2)
  bio               String?
  availableDays     String[] @default(["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY"])
  consultationStart String   @default("09:00")
  consultationEnd   String   @default("17:00")
  slotDuration      Int      @default(30)
  isAvailable       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User           @relation(fields: [userId], references: [id])
  department        Department?    @relation(fields: [departmentId], references: [id])
  appointments      Appointment[]
  prescriptions     Prescription[]
  chatRooms         ChatRoom[]
  referredLabOrders LabOrder[]

  @@map("doctors")
}

// ─────────────────────────────────────────
// PATIENT
// ─────────────────────────────────────────

model Patient {
  id                String    @id @default(cuid())
  userId            String    @unique
  tenantId          String
  patientCode       String    @unique
  dateOfBirth       DateTime?
  gender            Gender?
  bloodGroup        String?
  address           String?
  city              String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  allergies         String[]  @default([])
  chronicConditions String[]  @default([])
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id])
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  familyMembers FamilyMember[]
  appointments  Appointment[]
  prescriptions Prescription[]
  reports       Report[]
  timeline      PatientTimeline[]
  reminders     MedicineReminder[]
  invoices      Invoice[]
  chatRooms     ChatRoom[]
  labOrders     LabOrder[]

  @@map("patients")
}

// ─────────────────────────────────────────
// FAMILY MEMBER
// ─────────────────────────────────────────

model FamilyMember {
  id          String    @id @default(cuid())
  patientId   String
  name        String
  relation    String
  dateOfBirth DateTime?
  gender      Gender?
  bloodGroup  String?
  phone       String?
  allergies   String[]  @default([])
  createdAt   DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("family_members")
}

// ─────────────────────────────────────────
// APPOINTMENT
// ─────────────────────────────────────────

model Appointment {
  id            String            @id @default(cuid())
  tenantId      String
  patientId     String
  doctorId      String
  scheduledAt   DateTime
  endsAt        DateTime?
  status        AppointmentStatus @default(SCHEDULED)
  type          String            @default("CONSULTATION")
  reason        String?
  notes         String?
  followUpDate  DateTime?
  followUpNotes String?
  checkedInAt   DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  doctor        Doctor         @relation(fields: [doctorId], references: [id])
  prescriptions Prescription[]
  invoice       Invoice?

  @@map("appointments")
}

// ─────────────────────────────────────────
// PRESCRIPTION
// ─────────────────────────────────────────

model Prescription {
  id            String    @id @default(cuid())
  appointmentId String?
  patientId     String
  doctorId      String
  diagnosis     String?
  notes         String?
  pdfUrl        String?
  validUntil    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appointment Appointment?       @relation(fields: [appointmentId], references: [id])
  patient     Patient            @relation(fields: [patientId], references: [id])
  doctor      Doctor             @relation(fields: [doctorId], references: [id])
  medicines   Medicine[]
  reminders   MedicineReminder[]

  @@map("prescriptions")
}

// ─────────────────────────────────────────
// MEDICINE
// ─────────────────────────────────────────

model Medicine {
  id             String   @id @default(cuid())
  prescriptionId String
  name           String
  type           String   @default("MEDICINE")
  dosage         String
  frequency      String
  duration       String
  timing         String   @default("AFTER_FOOD")
  instructions   String?
  reminderTimes  String[] @default([])
  createdAt      DateTime @default(now())

  prescription Prescription       @relation(fields: [prescriptionId], references: [id])
  reminders    MedicineReminder[]

  @@map("medicines")
}

// ─────────────────────────────────────────
// MEDICINE REMINDER
// ─────────────────────────────────────────

model MedicineReminder {
  id             String              @id @default(cuid())
  patientId      String
  prescriptionId String
  medicineId     String
  scheduledAt    DateTime
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  patient      Patient      @relation(fields: [patientId], references: [id])
  prescription Prescription @relation(fields: [prescriptionId], references: [id])
  medicine     Medicine     @relation(fields: [medicineId], references: [id])

  @@map("medicine_reminders")
}

// ─────────────────────────────────────────
// REPORT
// ─────────────────────────────────────────

model Report {
  id          String     @id @default(cuid())
  tenantId    String
  patientId   String
  uploadedBy  String
  type        ReportType
  title       String
  description String?
  fileUrl     String
  fileName    String
  fileSize    Int?
  mimeType    String?
  labName     String?
  reportDate  DateTime?
  createdAt   DateTime   @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@map("reports")
}

// ─────────────────────────────────────────
// PATIENT TIMELINE
// ─────────────────────────────────────────

model PatientTimeline {
  id          String            @id @default(cuid())
  patientId   String
  eventType   TimelineEventType
  title       String
  description String?
  metadata    Json?
  occurredAt  DateTime          @default(now())
  createdAt   DateTime          @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("patient_timeline")
}

// ─────────────────────────────────────────
// NOTIFICATION
// ─────────────────────────────────────────

model Notification {
  id          String              @id @default(cuid())
  userId      String
  title       String
  body        String
  channel     NotificationChannel
  status      NotificationStatus  @default(PENDING)
  scheduledAt DateTime?
  sentAt      DateTime?
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// ─────────────────────────────────────────
// INVOICE
// ─────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String
  patientId     String
  appointmentId String?       @unique
  invoiceNo     String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  discount      Decimal?      @db.Decimal(10, 2)
  tax           Decimal?      @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  notes         String?
  pdfUrl        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@map("invoices")
}

// ─────────────────────────────────────────
// CHAT
// ─────────────────────────────────────────

model ChatRoom {
  id        String   @id @default(cuid())
  patientId String
  doctorId  String
  tenantId  String
  createdAt DateTime @default(now())

  patient  Patient   @relation(fields: [patientId], references: [id])
  doctor   Doctor    @relation(fields: [doctorId], references: [id])
  messages Message[]

  @@unique([patientId, doctorId])
  @@map("chat_rooms")
}

model Message {
  id         String    @id @default(cuid())
  chatRoomId String
  senderId   String
  content    String
  fileUrl    String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id])
  sender   User     @relation("SentMessages", fields: [senderId], references: [id])

  @@map("messages")
}

// ─────────────────────────────────────────
// TENANT REGISTRATION REQUEST
// ─────────────────────────────────────────

model TenantRequest {
  id           String           @id @default(cuid())
  type         TenantType       @default(HOSPITAL)
  name         String // Hospital/Clinic Name or Pharmacy Business Name
  email        String           @unique // Requester Admin Email
  phone        String?
  firstName    String // Requester Admin First Name
  lastName     String // Requester Admin Last Name
  address      String?
  city         String?
  state        String?
  plan         SubscriptionPlan @default(FREE) // Plan selected on the landing page
  status       RequestStatus    @default(PENDING)
  referredById String? // Referral.id resolved from an incoming referral code at submission time
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("tenant_requests")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum PayoutMethod {
  BANK_TRANSFER
  UPI
}

// ─────────────────────────────────────────
// REFERRAL PARTNER
// ─────────────────────────────────────────

model Referral {
  id                    String        @id @default(cuid())
  userId                String        @unique
  status                RequestStatus @default(PENDING)
  referralCode          String?       @unique // generated only when approved
  phone                 String?
  address               String?
  city                  String?
  state                 String?
  approvedAt            DateTime?
  approvedById          String? // audit-only id of the approving SUPER_ADMIN, no relation
  rejectedAt            DateTime?
  rejectedById          String?
  kycStatus             KycStatus     @default(NOT_SUBMITTED)
  kycGovtIdDocumentUrl  String?
  kycSubmittedAt        DateTime?
  kycReviewedAt         DateTime?
  kycReviewedById       String?
  kycRejectionReason    String?
  // Super-admin configurable payout rate for this partner, e.g. 10.00 or 15.00.
  commissionPercent     Decimal       @default(10) @db.Decimal(5, 2)
  // Payout destination details, self-reported by the partner.
  bankAccountHolderName String?
  bankAccountNumber     String?
  bankIfscCode          String?
  upiId                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user            User                 @relation(fields: [userId], references: [id])
  referredTenants Tenant[]             @relation("TenantReferredBy")
  commissions     ReferralCommission[]
  payouts         ReferralPayout[]

  @@map("referrals")
}

// Ledger of commission earned each time a referred tenant's subscription is
// charged, computed from Referral.commissionPercent at charge time so later
// rate changes don't retroactively alter already-recorded entries.
model ReferralCommission {
  id                String    @id @default(cuid())
  referralId        String
  tenantId          String
  subscriptionId    String
  commissionPercent Decimal   @db.Decimal(5, 2)
  amountInPaise     Int
  periodStart       DateTime?
  periodEnd         DateTime?
  // Null until a super admin records a manual payout covering this entry.
  payoutId          String?
  createdAt         DateTime  @default(now())

  referral     Referral        @relation(fields: [referralId], references: [id])
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  subscription Subscription    @relation(fields: [subscriptionId], references: [id])
  payout       ReferralPayout? @relation(fields: [payoutId], references: [id])

  @@unique([subscriptionId, periodStart])
  @@index([referralId])
  @@index([payoutId])
  @@map("referral_commissions")
}

// One row per manual payout event recorded by a super admin, covering one or
// more ReferralCommission entries for a single referral partner.
model ReferralPayout {
  id            String       @id @default(cuid())
  referralId    String
  amountInPaise Int
  method        PayoutMethod
  referenceNo   String?
  notes         String?
  paidAt        DateTime     @default(now())
  recordedById  String
  createdAt     DateTime     @default(now())

  referral    Referral             @relation(fields: [referralId], references: [id])
  recordedBy  User                 @relation(fields: [recordedById], references: [id])
  commissions ReferralCommission[]

  @@index([referralId])
  @@map("referral_payouts")
}

// ─────────────────────────────────────────
// MEDICAL CATALOG ITEM
// ─────────────────────────────────────────

model MedicalCatalogItem {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  type      String // "MEDICINE" or "OINTMENT"
  dosage    String? // suggested default dosage
  frequency String? // suggested default frequency
  timing    String? // suggested default timing
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name, type])
  @@map("medical_catalog_items")
}

// ─────────────────────────────────────────
// PHARMACY
// ─────────────────────────────────────────

model Pharmacy {
  id                    String   @id @default(cuid())
  tenantId              String
  userId                String?  @unique
  name                  String
  ownerName             String?
  licenseNumber         String?
  phone                 String
  email                 String?
  address               String
  city                  String?
  state                 String?
  pincode               String?
  openingHours          String?
  closingHours          String?
  homeDeliveryAvailable Boolean  @default(false)
  notes                 String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  medicines      PharmacyMedicine[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  patients       PharmacyPatient[]
  prescriptions  PharmacyPrescription[]
  sales          Sale[]
  returns        Return[]
  stockMovements StockMovement[]
  auditLogs      AuditLog[]

  @@map("pharmacies")
}

model PharmacyInvite {
  id        String    @id @default(cuid())
  tenantId  String
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("pharmacy_invites")
}

// ─────────────────────────────────────────
// PHARMACY OPERATIONS — MEDICINE CATALOG & INVENTORY
// ─────────────────────────────────────────

model PharmacyMedicine {
  id                   String   @id @default(cuid())
  pharmacyId           String
  name                 String
  genericName          String?
  brandName            String?
  composition          String?
  form                 String?
  strength             String?
  hsn                  String?
  gst                  Decimal? @db.Decimal(5, 2)
  mrp                  Decimal  @db.Decimal(10, 2)
  salePrice            Decimal  @db.Decimal(10, 2)
  barcode              String?
  reorderLevel         Int      @default(0)
  prescriptionRequired Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  pharmacy          Pharmacy           @relation(fields: [pharmacyId], references: [id])
  batches           MedicineBatch[]
  purchaseItems     PurchaseItem[]
  prescriptionItems PrescriptionItem[]
  saleItems         SaleItem[]
  returnItems       ReturnItem[]
  stockMovements    StockMovement[]

  @@unique([pharmacyId, barcode])
  @@map("pharmacy_medicines")
}

model MedicineBatch {
  id            String      @id @default(cuid())
  medicineId    String
  batchNo       String
  mfgDate       DateTime?
  expiryDate    DateTime
  purchasePrice Decimal     @db.Decimal(10, 2)
  mrp           Decimal     @db.Decimal(10, 2)
  salePrice     Decimal     @db.Decimal(10, 2)
  quantity      Int         @default(0)
  supplierId    String?
  status        BatchStatus @default(ACTIVE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  medicine       PharmacyMedicine @relation(fields: [medicineId], references: [id])
  supplier       Supplier?        @relation(fields: [supplierId], references: [id])
  dispenseItems  DispenseItem[]
  saleItems      SaleItem[]
  returnItems    ReturnItem[]
  stockMovements StockMovement[]

  @@unique([medicineId, batchNo])
  @@map("medicine_batches")
}

model Supplier {
  id         String   @id @default(cuid())
  pharmacyId String
  name       String
  phone      String?
  email      String?
  address    String?
  gstin      String?
  licenseNo  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pharmacy       Pharmacy        @relation(fields: [pharmacyId], references: [id])
  batches        MedicineBatch[]
  purchaseOrders PurchaseOrder[]
  returns        Return[]

  @@map("suppliers")
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  pharmacyId      String
  supplierId      String
  orderNo         String
  orderDate       DateTime?
  invoiceNo       String?
  invoiceDate     DateTime?
  status          PurchaseOrderStatus @default(DRAFT)
  subtotal        Decimal             @db.Decimal(10, 2)
  discount        Decimal             @default(0) @db.Decimal(10, 2)
  cashDiscount    Decimal             @default(0) @db.Decimal(10, 2)
  tax             Decimal             @default(0) @db.Decimal(10, 2)
  creditNote      Decimal             @default(0) @db.Decimal(10, 2)
  debitNote       Decimal             @default(0) @db.Decimal(10, 2)
  otherAdjustment Decimal             @default(0) @db.Decimal(10, 2)
  total           Decimal             @db.Decimal(10, 2)
  orderedAt       DateTime?
  receivedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  pharmacy Pharmacy       @relation(fields: [pharmacyId], references: [id])
  supplier Supplier       @relation(fields: [supplierId], references: [id])
  items    PurchaseItem[]

  @@unique([pharmacyId, orderNo])
  @@map("purchase_orders")
}

model PurchaseItem {
  id               String   @id @default(cuid())
  purchaseOrderId  String
  medicineId       String
  batchNo          String
  expiryDate       DateTime
  quantity         Int
  freeQty          Int      @default(0)
  receivedQuantity Int      @default(0)
  rate             Decimal  @db.Decimal(10, 2)
  tax              Decimal  @default(0) @db.Decimal(10, 2)
  hsnCode          String?
  gstPercent       Decimal? @db.Decimal(5, 2)
  mrp              Decimal? @db.Decimal(10, 2)
  packSize         String?
  manufacturer     String?
  createdAt        DateTime @default(now())

  purchaseOrder PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id])
  medicine      PharmacyMedicine @relation(fields: [medicineId], references: [id])

  @@map("purchase_items")
}

// ─────────────────────────────────────────
// PHARMACY OPERATIONS — PATIENTS & PRESCRIPTIONS
// ─────────────────────────────────────────

model PharmacyPatient {
  id               String   @id @default(cuid())
