}

model DispenseItem {
  id                 String @id @default(cuid())
  dispenseId         String
  prescriptionItemId String
  batchId            String
  quantity           Int

  dispense         Dispense         @relation(fields: [dispenseId], references: [id])
  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
