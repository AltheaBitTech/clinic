// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  RECEPTIONIST
  PATIENT
  PHARMACY
}

enum TenantType {
  HOSPITAL
  PHARMACY
}

enum SubscriptionPlan {
  FREE
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum ReportType {
  BLOOD_TEST
  XRAY
  MRI
  CT_SCAN
  ULTRASOUND
  ECG
  PRESCRIPTION
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

enum TimelineEventType {
  APPOINTMENT
  PRESCRIPTION
  MEDICINE_STARTED
  REPORT_UPLOADED
  FOLLOW_UP
  REMINDER_SENT
  NOTE_ADDED
}

// ─────────────────────────────────────────
// PHARMACY OPERATIONS ENUMS
// ─────────────────────────────────────────

enum BatchStatus {
  ACTIVE
  BLOCKED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PharmacyPrescriptionStatus {
  PENDING
  VERIFIED
  DISPENSED
  PARTIALLY_DISPENSED
  CANCELLED
}

enum DispenseStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  SALE
  DISPENSE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum ReturnType {
  CUSTOMER
  SUPPLIER
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// ─────────────────────────────────────────
// TENANT (Hospital / Clinic)
// ─────────────────────────────────────────

model Tenant {
  id                 String           @id @default(cuid())
  type               TenantType       @default(HOSPITAL)
  name               String
  slug               String           @unique
  email              String
  phone              String?
  address            String?
  city               String?
  state              String?
  country            String?          @default("India")
  logoUrl            String?
  website            String?
  licenseNumber      String?
  subscriptionPlan   SubscriptionPlan @default(FREE)
  subscriptionEndsAt DateTime?
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  users               User[]
  departments         Department[]
  patients            Patient[]
  appointments        Appointment[]
  reports             Report[]
  invoices            Invoice[]
  invites             HospitalInvite[]
  medicalCatalogItems MedicalCatalogItem[]
  pharmacies          Pharmacy[]
  pharmacyInvites     PharmacyInvite[]

  @@map("tenants")
}

// ─────────────────────────────────────────
// USER
// ─────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  tenantId     String?
  email        String    @unique
  phone        String?   @unique
  passwordHash String?
  firstName    String
  lastName     String
  role         UserRole  @default(PATIENT)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  isVerified   Boolean   @default(false)
  googleId     String?   @unique
  refreshToken String?
  otp          String?
  otpExpiresAt DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  doctor        Doctor?
  patient       Patient?
  pharmacy      Pharmacy?
  sentMessages  Message[]      @relation("SentMessages")
  notifications Notification[]

  @@map("users")
}

// ─────────────────────────────────────────
// HOSPITAL INVITE
// ─────────────────────────────────────────

model HospitalInvite {
  id        String    @id @default(cuid())
  tenantId  String
  email     String
  role      UserRole
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("hospital_invites")
}

// ─────────────────────────────────────────
// DEPARTMENT
// ─────────────────────────────────────────

model Department {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  doctors Doctor[]

  @@map("departments")
}

// ─────────────────────────────────────────
// DOCTOR
// ─────────────────────────────────────────

model Doctor {
  id                String   @id @default(cuid())
  userId            String   @unique
  tenantId          String
  departmentId      String?
  specialization    String
  qualification     String?
  registrationNo    String?
  experienceYears   Int?
  consultationFee   Decimal? @db.Decimal(10, 2)
  bio               String?
  availableDays     String[] @default(["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY"])
  consultationStart String   @default("09:00")
  consultationEnd   String   @default("17:00")
  slotDuration      Int      @default(30)
  isAvailable       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  department    Department?    @relation(fields: [departmentId], references: [id])
  appointments  Appointment[]
  prescriptions Prescription[]
  chatRooms     ChatRoom[]

  @@map("doctors")
}

// ─────────────────────────────────────────
// PATIENT
// ─────────────────────────────────────────

model Patient {
  id                String    @id @default(cuid())
  userId            String    @unique
  tenantId          String
  patientCode       String    @unique
  dateOfBirth       DateTime?
  gender            Gender?
  bloodGroup        String?
  address           String?
  city              String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  allergies         String[]  @default([])
  chronicConditions String[]  @default([])
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id])
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  familyMembers FamilyMember[]
  appointments  Appointment[]
  prescriptions Prescription[]
  reports       Report[]
  timeline      PatientTimeline[]
  reminders     MedicineReminder[]
  invoices      Invoice[]
  chatRooms     ChatRoom[]

  @@map("patients")
}

// ─────────────────────────────────────────
// FAMILY MEMBER
// ─────────────────────────────────────────

model FamilyMember {
  id          String    @id @default(cuid())
  patientId   String
  name        String
  relation    String
  dateOfBirth DateTime?
  gender      Gender?
  bloodGroup  String?
  phone       String?
  allergies   String[]  @default([])
  createdAt   DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("family_members")
}

// ─────────────────────────────────────────
// APPOINTMENT
// ─────────────────────────────────────────

model Appointment {
  id            String            @id @default(cuid())
  tenantId      String
  patientId     String
  doctorId      String
  scheduledAt   DateTime
  endsAt        DateTime?
  status        AppointmentStatus @default(SCHEDULED)
  type          String            @default("CONSULTATION")
  reason        String?
  notes         String?
  followUpDate  DateTime?
  followUpNotes String?
  checkedInAt   DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  doctor        Doctor         @relation(fields: [doctorId], references: [id])
  prescriptions Prescription[]
  invoice       Invoice?

  @@map("appointments")
}

// ─────────────────────────────────────────
// PRESCRIPTION
// ─────────────────────────────────────────

model Prescription {
  id            String    @id @default(cuid())
  appointmentId String?
  patientId     String
  doctorId      String
  diagnosis     String?
  notes         String?
  pdfUrl        String?
  validUntil    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appointment Appointment?       @relation(fields: [appointmentId], references: [id])
  patient     Patient            @relation(fields: [patientId], references: [id])
  doctor      Doctor             @relation(fields: [doctorId], references: [id])
  medicines   Medicine[]
  reminders   MedicineReminder[]

  @@map("prescriptions")
}

// ─────────────────────────────────────────
// MEDICINE
// ─────────────────────────────────────────

model Medicine {
  id             String   @id @default(cuid())
  prescriptionId String
  name           String
  type           String   @default("MEDICINE")
  dosage         String
  frequency      String
  duration       String
  timing         String   @default("AFTER_FOOD")
  instructions   String?
  reminderTimes  String[] @default([])
  createdAt      DateTime @default(now())

  prescription Prescription       @relation(fields: [prescriptionId], references: [id])
  reminders    MedicineReminder[]

  @@map("medicines")
}

// ─────────────────────────────────────────
// MEDICINE REMINDER
// ─────────────────────────────────────────

model MedicineReminder {
  id             String              @id @default(cuid())
  patientId      String
  prescriptionId String
  medicineId     String
  scheduledAt    DateTime
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  patient      Patient      @relation(fields: [patientId], references: [id])
  prescription Prescription @relation(fields: [prescriptionId], references: [id])
  medicine     Medicine     @relation(fields: [medicineId], references: [id])

  @@map("medicine_reminders")
}

// ─────────────────────────────────────────
// REPORT
// ─────────────────────────────────────────

model Report {
  id          String     @id @default(cuid())
  tenantId    String
  patientId   String
  uploadedBy  String
  type        ReportType
  title       String
  description String?
  fileUrl     String
  fileName    String
  fileSize    Int?
  mimeType    String?
  labName     String?
  reportDate  DateTime?
  createdAt   DateTime   @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@map("reports")
}

// ─────────────────────────────────────────
// PATIENT TIMELINE
// ─────────────────────────────────────────

model PatientTimeline {
  id          String            @id @default(cuid())
  patientId   String
  eventType   TimelineEventType
  title       String
  description String?
  metadata    Json?
  occurredAt  DateTime          @default(now())
  createdAt   DateTime          @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("patient_timeline")
}

// ─────────────────────────────────────────
// NOTIFICATION
// ─────────────────────────────────────────

model Notification {
  id          String              @id @default(cuid())
  userId      String
  title       String
  body        String
  channel     NotificationChannel
  status      NotificationStatus  @default(PENDING)
  scheduledAt DateTime?
  sentAt      DateTime?
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// ─────────────────────────────────────────
// INVOICE
// ─────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String
  patientId     String
  appointmentId String?       @unique
  invoiceNo     String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  discount      Decimal?      @db.Decimal(10, 2)
  tax           Decimal?      @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  notes         String?
  pdfUrl        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@map("invoices")
}

// ─────────────────────────────────────────
// CHAT
// ─────────────────────────────────────────

model ChatRoom {
  id        String   @id @default(cuid())
  patientId String
  doctorId  String
  tenantId  String
  createdAt DateTime @default(now())

  patient  Patient   @relation(fields: [patientId], references: [id])
  doctor   Doctor    @relation(fields: [doctorId], references: [id])
  messages Message[]

  @@unique([patientId, doctorId])
  @@map("chat_rooms")
}

model Message {
  id         String    @id @default(cuid())
  chatRoomId String
  senderId   String
  content    String
  fileUrl    String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id])
  sender   User     @relation("SentMessages", fields: [senderId], references: [id])

  @@map("messages")
}

// ─────────────────────────────────────────
// TENANT REGISTRATION REQUEST
// ─────────────────────────────────────────

model TenantRequest {
  id        String           @id @default(cuid())
  type      TenantType       @default(HOSPITAL)
  name      String // Hospital/Clinic Name or Pharmacy Business Name
  email     String           @unique // Requester Admin Email
  phone     String?
  firstName String // Requester Admin First Name
  lastName  String // Requester Admin Last Name
  address   String?
  city      String?
  state     String?
  plan      SubscriptionPlan @default(FREE) // Plan selected on the landing page
  status    RequestStatus    @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("tenant_requests")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────
// MEDICAL CATALOG ITEM
// ─────────────────────────────────────────

model MedicalCatalogItem {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  type      String // "MEDICINE" or "OINTMENT"
  dosage    String? // suggested default dosage
  frequency String? // suggested default frequency
  timing    String? // suggested default timing
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name, type])
  @@map("medical_catalog_items")
}

// ─────────────────────────────────────────
// PHARMACY
// ─────────────────────────────────────────

model Pharmacy {
  id                    String   @id @default(cuid())
  tenantId              String
  userId                String?  @unique
  name                  String
  ownerName             String?
  licenseNumber         String?
  phone                 String
  email                 String?
  address               String
  city                  String?
  state                 String?
  pincode               String?
  openingHours          String?
  closingHours          String?
  homeDeliveryAvailable Boolean  @default(false)
  notes                 String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  medicines      PharmacyMedicine[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  patients       PharmacyPatient[]
  prescriptions  PharmacyPrescription[]
  sales          Sale[]
  returns        Return[]
  stockMovements StockMovement[]
  auditLogs      AuditLog[]

  @@map("pharmacies")
}

model PharmacyInvite {
  id        String    @id @default(cuid())
  tenantId  String
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("pharmacy_invites")
}

// ─────────────────────────────────────────
// PHARMACY OPERATIONS — MEDICINE CATALOG & INVENTORY
// ─────────────────────────────────────────

model PharmacyMedicine {
  id                   String   @id @default(cuid())
  pharmacyId           String
  name                 String
  genericName          String?
  brandName            String?
  composition          String?
  form                 String?
  strength             String?
  hsn                  String?
  gst                  Decimal? @db.Decimal(5, 2)
  mrp                  Decimal  @db.Decimal(10, 2)
  salePrice            Decimal  @db.Decimal(10, 2)
  barcode              String?
  reorderLevel         Int      @default(0)
  prescriptionRequired Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  pharmacy          Pharmacy           @relation(fields: [pharmacyId], references: [id])
  batches           MedicineBatch[]
  purchaseItems     PurchaseItem[]
  prescriptionItems PrescriptionItem[]
  saleItems         SaleItem[]
  returnItems       ReturnItem[]
  stockMovements    StockMovement[]

  @@unique([pharmacyId, barcode])
  @@map("pharmacy_medicines")
}

model MedicineBatch {
  id            String      @id @default(cuid())
  medicineId    String
  batchNo       String
  mfgDate       DateTime?
  expiryDate    DateTime
  purchasePrice Decimal     @db.Decimal(10, 2)
  mrp           Decimal     @db.Decimal(10, 2)
  salePrice     Decimal     @db.Decimal(10, 2)
  quantity      Int         @default(0)
  supplierId    String?
  status        BatchStatus @default(ACTIVE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  medicine       PharmacyMedicine @relation(fields: [medicineId], references: [id])
  supplier       Supplier?        @relation(fields: [supplierId], references: [id])
  dispenseItems  DispenseItem[]
  saleItems      SaleItem[]
  returnItems    ReturnItem[]
  stockMovements StockMovement[]

  @@unique([medicineId, batchNo])
  @@map("medicine_batches")
}

model Supplier {
  id         String   @id @default(cuid())
  pharmacyId String
  name       String
  phone      String?
  email      String?
  address    String?
  gstin      String?
  licenseNo  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pharmacy       Pharmacy        @relation(fields: [pharmacyId], references: [id])
  batches        MedicineBatch[]
  purchaseOrders PurchaseOrder[]
  returns        Return[]

  @@map("suppliers")
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  pharmacyId       String
  supplierId       String
  orderNo          String
  orderDate        DateTime?
  invoiceNo        String?
  invoiceDate      DateTime?
  status           PurchaseOrderStatus @default(DRAFT)
  subtotal         Decimal             @db.Decimal(10, 2)
  discount         Decimal             @default(0) @db.Decimal(10, 2)
  cashDiscount     Decimal             @default(0) @db.Decimal(10, 2)
  tax              Decimal             @default(0) @db.Decimal(10, 2)
  creditNote       Decimal             @default(0) @db.Decimal(10, 2)
  debitNote        Decimal             @default(0) @db.Decimal(10, 2)
  otherAdjustment  Decimal             @default(0) @db.Decimal(10, 2)
  total            Decimal             @db.Decimal(10, 2)
  orderedAt        DateTime?
  receivedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  pharmacy Pharmacy       @relation(fields: [pharmacyId], references: [id])
  supplier Supplier       @relation(fields: [supplierId], references: [id])
  items    PurchaseItem[]

  @@unique([pharmacyId, orderNo])
  @@map("purchase_orders")
}

model PurchaseItem {
  id               String   @id @default(cuid())
  purchaseOrderId  String
  medicineId       String
  batchNo          String
  expiryDate       DateTime
  quantity         Int
  freeQty          Int      @default(0)
  receivedQuantity Int      @default(0)
  rate             Decimal  @db.Decimal(10, 2)
  tax              Decimal  @default(0) @db.Decimal(10, 2)
  hsnCode          String?
  gstPercent       Decimal? @db.Decimal(5, 2)
  mrp              Decimal? @db.Decimal(10, 2)
  packSize         String?
  manufacturer     String?
  createdAt        DateTime @default(now())

  purchaseOrder PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id])
  medicine      PharmacyMedicine @relation(fields: [medicineId], references: [id])

  @@map("purchase_items")
}

// ─────────────────────────────────────────
// PHARMACY OPERATIONS — PATIENTS & PRESCRIPTIONS
// ─────────────────────────────────────────

model PharmacyPatient {
  id               String   @id @default(cuid())
  pharmacyId       String
  arogyixPatientId String?
  name             String
  phone            String?
  email            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pharmacy      Pharmacy               @relation(fields: [pharmacyId], references: [id])
  prescriptions PharmacyPrescription[]
  sales         Sale[]

  @@map("pharmacy_patients")
}

model PharmacyPrescription {
  id                    String                     @id @default(cuid())
  pharmacyId            String
  patientId             String
  doctorId              String?
  appointmentId         String?
  arogyixPrescriptionId String?                    @unique
  status                PharmacyPrescriptionStatus @default(PENDING)
  diagnosis             String?
  advice                String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  pharmacy  Pharmacy           @relation(fields: [pharmacyId], references: [id])
  patient   PharmacyPatient    @relation(fields: [patientId], references: [id])
  items     PrescriptionItem[]
  dispenses Dispense[]

  @@map("pharmacy_prescriptions")
}

model PrescriptionItem {
  id             String   @id @default(cuid())
  prescriptionId String
  medicineId     String?
  medicineName   String
  dosage         String?
  frequency      String?
  duration       String?
  quantity       Int
  instructions   String?
  createdAt      DateTime @default(now())

  prescription  PharmacyPrescription @relation(fields: [prescriptionId], references: [id])
  medicine      PharmacyMedicine?    @relation(fields: [medicineId], references: [id])
  dispenseItems DispenseItem[]

  @@map("prescription_items")
}

model Dispense {
  id             String         @id @default(cuid())
  prescriptionId String
  userId         String
  status         DispenseStatus @default(PENDING)
  dispensedAt    DateTime?
  createdAt      DateTime       @default(now())

  prescription PharmacyPrescription @relation(fields: [prescriptionId], references: [id])
  items        DispenseItem[]

  @@map("dispenses")
}

model DispenseItem {
  id                 String @id @default(cuid())
  dispenseId         String
  prescriptionItemId String
  batchId            String
  quantity           Int

  dispense         Dispense         @relation(fields: [dispenseId], references: [id])
  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  batch            MedicineBatch    @relation(fields: [batchId], references: [id])

  @@map("dispense_items")
}

// ─────────────────────────────────────────
// PHARMACY OPERATIONS — SALES (POS) & RETURNS
// ─────────────────────────────────────────

model Sale {
  id            String        @id @default(cuid())
  pharmacyId    String
  patientId     String?
  invoiceNo     String
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PAID)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  pharmacy Pharmacy         @relation(fields: [pharmacyId], references: [id])
  patient  PharmacyPatient? @relation(fields: [patientId], references: [id])
  items    SaleItem[]
  payments Payment[]
  returns  Return[]

  @@unique([pharmacyId, invoiceNo])
  @@map("sales")
}

model SaleItem {
  id         String   @id @default(cuid())
  saleId     String
  medicineId String
  batchId    String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  discount   Decimal  @default(0) @db.Decimal(10, 2)
  tax        Decimal  @default(0) @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  sale     Sale             @relation(fields: [saleId], references: [id])
  medicine PharmacyMedicine @relation(fields: [medicineId], references: [id])
  batch    MedicineBatch    @relation(fields: [batchId], references: [id])

  @@map("sale_items")
}

model Payment {
  id          String   @id @default(cuid())
  saleId      String
  method      String
  amount      Decimal  @db.Decimal(10, 2)
  referenceNo String?
  createdAt   DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id])

  @@map("payments")
}

model Return {
  id         String       @id @default(cuid())
  pharmacyId String
  saleId     String?
  supplierId String?
  type       ReturnType
  reason     String
  status     ReturnStatus @default(PENDING)
  total      Decimal      @db.Decimal(10, 2)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  pharmacy Pharmacy     @relation(fields: [pharmacyId], references: [id])
  sale     Sale?        @relation(fields: [saleId], references: [id])
  supplier Supplier?    @relation(fields: [supplierId], references: [id])
  items    ReturnItem[]

  @@map("returns")
}

model ReturnItem {
  id         String  @id @default(cuid())
  returnId   String
  medicineId String
  batchId    String
  quantity   Int
  amount     Decimal @db.Decimal(10, 2)

  return   Return           @relation(fields: [returnId], references: [id])
  medicine PharmacyMedicine @relation(fields: [medicineId], references: [id])
  batch    MedicineBatch    @relation(fields: [batchId], references: [id])

  @@map("return_items")
}

// ─────────────────────────────────────────
// PHARMACY OPERATIONS — STOCK LEDGER & AUDIT
// ─────────────────────────────────────────

model StockMovement {
  id            String            @id @default(cuid())
  pharmacyId    String
  medicineId    String
  batchId       String
  type          StockMovementType
  quantity      Int
  referenceType String
  referenceId   String
  reason        String?
  createdBy     String
  createdAt     DateTime          @default(now())

  pharmacy Pharmacy         @relation(fields: [pharmacyId], references: [id])
  medicine PharmacyMedicine @relation(fields: [medicineId], references: [id])
  batch    MedicineBatch    @relation(fields: [batchId], references: [id])

  @@map("stock_movements")
}

model AuditLog {
  id         String   @id @default(cuid())
  pharmacyId String
  userId     String
  action     String
  entity     String
  entityId   String
  beforeData Json?
  afterData  Json?
  createdAt  DateTime @default(now())

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id])

  @@map("audit_logs")
}
