{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "nextjs"
        },
        "backend": {
            "root": "backend",
            "entrypoint": "src/main.ts"
        }
    },
    "rewrites": [
        {
            "source": "/api/backend(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ],
    "crons": [
        {
            "path": "/api/backend/api/v1/reminders/cron/medicine",
            "schedule": "*/15 * * * *"
        },
        {
            "path": "/api/backend/api/v1/reminders/cron/appointments",
            "schedule": "0 * * * *"
        }
    ]
}
