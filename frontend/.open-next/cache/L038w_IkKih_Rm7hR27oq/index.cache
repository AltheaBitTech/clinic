s/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"inter_5901b7c6-module__ec5Qua__variable font-sans antialiased\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"min-h-screen bg-gradient-to-br from-slate-950 via-cyan-950 to-slate-900 text-white overflow-x-hidden relative\"><div class=\"absolute top-0 left-1/4 w-[500px] h-[500px] bg-cyan-600/10 rounded-full blur-[120px] -z-10 pointer-events-none\"></div><div class=\"absolute top-40 right-1/4 w-[400px] h-[400px] bg-emerald-600/10 rounded-full blur-[100px] -z-10 pointer-events-none\"></div><header class=\"sticky top-0 z-50 bg-slate-950/60 backdrop-blur-lg border-b border-white/5\"><nav class=\"flex items-center justify-between px-4 sm:px-6 lg:px-8 py-4 max-w-7xl mx-auto\"><div class=\"flex items-center gap-2.5\"><img alt=\"Arogyix\" loading=\"lazy\" width=\"36\" height=\"36\" decoding=\"async\" data-nimg=\"1\" class=\"drop-shadow-md\" style=\"color:transparent\" src=\"/arogyix-logo.svg\"/><span class=\"text-xl font-bold tracking-tight bg-gradient-to-r from-white to-slate-200 bg-clip-text text-transparent\">Arogyix</span></div><div class=\"flex items-center gap-5\"><a href=\"#pricing\" class=\"hidden sm:inline text-slate-300 hover:text-white transition-colors text-sm font-semibold\">Pricing</a><a class=\"text-slate-300 hover:text-white transition-colors text-sm font-semibold\" href=\"/login\">Sign In</a><a class=\"btn-primary text-sm shadow-md\" href=\"/register\">Get Started Free</a></div></nav></header><section class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-28 text-center relative\"><div class=\"inline-flex items-center gap-2 bg-cyan-500/10 border border-cyan-500/20 rounded-full px-4.5 py-1.5 text-xs font-semibold text-cyan-300 mb-8 animate-fade-in\"><span class=\"w-1.5 h-1.5 bg-cyan-400 rounded-full animate-pulse\"></span>Multi-Tenant Hospital SaaS Platform</div><h1 class=\"text-5xl md:text-6xl lg:text-7xl font-extrabold leading-[1.1] mb-4 bg-gradient-to-r from-white via-cyan-100 to-emerald-200 bg-clip-text text-transparent tracking-tight\">Healthcare management <br class=\"hidden md:inline\"/> made simple.</h1><p class=\"text-lg md:text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed font-light\">Appointments, digital prescriptions, medicine reminders, patient timelines, and real-time chat — unified in a single, high-performance platform.</p><div class=\"flex items-center justify-center gap-4.5 flex-wrap animate-slide-up\"><a class=\"btn-primary flex items-center gap-2 text-base px-4 sm:px-6 lg:px-8 py-3.5 shadow-lg\" href=\"/register\">Start for Free <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-4.5 h-4.5\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"btn-secondary text-base px-4 sm:px-6 lg:px-8 py-3.5 bg-white/5 text-white hover:bg-white/10 border border-white/15 backdrop-blur-sm\" href=\"/login\">Sign In</a></div></section><section class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-28 relative\"><div class=\"absolute -left-20 top-40 w-80 h-80 bg-emerald-600/5 rounded-full blur-[100px] -z-10 pointer-events-none\"></div><h2 class=\"text-3xl md:text-4xl font-extrabold text-center mb-3 tracking-tight\">Everything your clinic needs</h2><p class=\"text-slate-400 text-center mb-16 max-w-xl mx-auto font-light\">From individual doctors to multi-speciality hospitals, Arogyix scales with your operation.</p><div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\"><div class=\"bg-white/[0.02] border border-white/10 rounded-2xl p-6.5 hover:bg-white/[0.06] hover:border-white/20 hover:-translate-y-1.5 transition-all duration-300 group\"><div class=\"w-11 h-11 rounded-xl bg-cyan-500/10 border-cyan-500/20 border flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-calendar w-5 h-5 text-cyan-400\" aria-hidden=\"true\"><path d=\"M8 2v4\"></path><path d=\"M16 2v4\"></path><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"></rect><path d=\"M3 10h18\"></path></svg></div><h3 class=\"font-semibold text-lg mb-2.5 text-slate-100 group-hover:text-white transition-colors\">Smart Appointments</h3><p class=\"text-slate-400 text-sm leading-relaxed font-light\">Book, reschedule, and track appointments. Automatic reminders 24h before.</p></div><div class=\"bg-white/[0.02] border border-white/10 rounded-2xl p-6.5 hover:bg-white/[0.06] hover:border-white/20 hover:-translate-y-1.5 transition-all duration-300 group\"><div class=\"w-11 h-11 rounded-xl bg-emerald-500/10 border-emerald-500/20 border flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-text w-5 h-5 text-emerald-400\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M14 2v5a1 1 0 0 0 1 1h5\"></path><path d=\"M10 9H8\"></path><path d=\"M16 13H8\"></path><path d=\"M16 17H8\"></path></svg></div><h3 class=\"font-semibold text-lg mb-2.5 text-slate-100 group-hover:text-white transition-colors\">Digital Prescriptions</h3><p class=\"text-slate-400 text-sm leading-relaxed font-light\">Write prescriptions digitally. PDFs auto-generated and shared via WhatsApp &amp; email.</p></div><div class=\"bg-white/[0.02] border border-white/10 rounded-2xl p-6.5 hover:bg-white/[0.06] hover:border-white/20 hover:-translate-y-1.5 transition-all duration-300 group\"><div class=\"w-11 h-11 rounded-xl bg-amber-500/10 border-amber-500/20 border flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-bell w-5 h-5 text-amber-400\" aria-hidden=\"true\"><path d=\"M10.268 21a2 2 0 0 0 3.464 0\"></path><path d=\"M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326\"></path></svg></div><h3 class=\"font-semibold text-lg mb-2.5 text-slate-100 group-hover:text-white transition-colors\">Medicine Reminders</h3><p class=\"text-slate-400 text-sm leading-relaxed font-light\">Push, SMS, WhatsApp, and email reminders for every medicine schedule.</p></div><div class=\"bg-white/[0.02] border border-white/10 rounded-2xl p-6.5 hover:bg-white/[0.06] hover:border-white/20 hover:-translate-y-1.5 transition-all duration-300 group\"><div class=\"w-11 h-11 rounded-xl bg-purple-500/10 border-purple-500/20 border flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-activity w-5 h-5 text-purple-400\" aria-hidden=\"true\"><path d=\"M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2\"></path></svg></div><h3 class=\"font-semibold text-lg mb-2.5 text-slate-100 group-hover:text-white transition-colors\">Patient Timeline</h3><p class=\"text-slate-400 text-sm leading-relaxed font-light\">Chronological view of every visit, prescription, test, and follow-up.</p></div><div class=\"bg-white/[0.02] border border-white/10 rounded-2xl p-6.5 hover:bg-white/[0.06] hover:border-white/20 hover:-translate-y-1.5 transition-all duration-300 group\"><div class=\"w-11 h-11 rounded-xl bg-blue-500/10 border-blue-500/20 border flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield w-5 h-5 text-blue-400\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path></svg></div><h3 class=\"font-semibold text-lg mb-2.5 text-slate-100 group-hover:text-white transition-colors\">Multi-Tenant Security</h3><p class=\"text-slate-400 text-sm leading-relaxed font-light\">Every hospital is fully isolated. RBAC with 5 roles. JWT auth.</p></div><div class=\"bg-white/[0.02] border border-white/10 rounded-2xl p-6.5 hover:bg-white/[0.06] hover:border-white/20 hover:-translate-y-1.5 transition-all duration-300 group\"><div class=\"w-11 h-11 rounded-xl bg-rose-500/10 border-rose-500/20 border flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users w-5 h-5 text-rose-400\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg></div><h3 class=\"font-semibold text-lg mb-2.5 text-slate-100 group-hover:text-white transition-colors\">Family Health Records</h3><p class=\"text-slate-400 text-sm leading-relaxed font-light\">Patients can manage health records for their entire family.</p></div></div></section><section class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-28 relative\"><h2 class=\"text-3xl font-extrabold text-center mb-12 tracking-tight\">Built for every role</h2><div class=\"grid grid-cols-2 md:grid-cols-5 gap-5\"><div class=\"bg-purple-500/10 border-purple-500/20 border rounded-2xl p-5.5 text-center hover:bg-white/[0.02] transition-colors duration-300\"><div class=\"text-purple-400 font-bold text-base mb-1.5\">Super Admin</div><div class=\"text-slate-400 text-xs leading-relaxed font-light\">Platform &amp; billing</div></div><div class=\"bg-blue-500/10 border-blue-500/20 border rounded-2xl p-5.5 text-center hover:bg-white/[0.02] transition-colors duration-300\"><div class=\"text-blue-400 font-bold text-base mb-1.5\">Hospital Admin</div><div class=\"text-slate-400 text-xs leading-relaxed font-light\">Staff &amp; reports</div></div><div class=\"bg-emerald-500/10 border-emerald-500/20 border rounded-2xl p-5.5 text-center hover:bg-white/[0.02] transition-colors duration-300\"><div class=\"text-emerald-400 font-bold text-base mb-1.5\">Doctor</div><div class=\"text-slate-400 text-xs leading-relaxed font-light\">Appointments &amp; Rx</div></div><div class=\"bg-amber-500/10 border-amber-500/20 border rounded-2xl p-5.5 text-center hover:bg-white/[0.02] transition-colors duration-300\"><div class=\"text-amber-400 font-bold text-base mb-1.5\">Receptionist</div><div class=\"text-slate-400 text-xs leading-relaxed font-light\">Registration &amp; billing</div></div><div class=\"bg-rose-500/10 border-rose-500/20 border rounded-2xl p-5.5 text-center hover:bg-white/[0.02] transition-colors duration-300\"><div class=\"text-rose-400 font-bold text-base mb-1.5\">Patient</div><div class=\"text-slate-400 text-xs leading-relaxed font-light\">Health portal</div></div></div></section><section id=\"pricing\" class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-28 relative scroll-mt-24\"><div class=\"absolute -right-20 top-20 w-80 h-80 bg-cyan-600/5 rounded-full blur-[100px] -z-10 pointer-events-none\"></div><h2 class=\"text-3xl md:text-4xl font-extrabold text-center mb-3 tracking-tight\">Simple, transparent pricing</h2><p class=\"text-slate-400 text-center mb-16 max-w-xl mx-auto font-light\">Start free, then pick the plan that fits your clinic. No hidden fees.</p><div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 items-start\"><div class=\"relative rounded-2xl p-7 border transition-all duration-300 bg-white/[0.02] border-white/10 hover:bg-white/[0.06] hover:border-white/20 hover:-translate-y-1.5\"><div class=\"w-11 h-11 rounded-xl bg-emerald-500/10 border-emerald-500/20 border flex items-center justify-center mb-5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sparkles w-5 h-5 text-emerald-400\" aria-hidden=\"true\"><path d=\"M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z\"></path><path d=\"M20 2v4\"></path><path d=\"M22 4h-4\"></path><circle cx=\"4\" cy=\"20\" r=\"2\"></circle></svg></div><h3 class=\"font-bold text-xl mb-1 text-slate-100\">Free Trial</h3><p class=\"text-slate-400 text-sm mb-5 font-light\">Try every feature, no card required</p><div class=\"flex items-baseline gap-1.5 mb-6\"><span class=\"text-3.5xl font-extrabold text-white\">₹0</span><span class=\"text-slate-400 text-sm font-light\">/ 15 days</span></div><ul class=\"space-y-3 mb-8\"><li class=\"flex items-start gap-2.5 text-sm text-slate-300 font-light\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big w-4 h-4 text-emerald-400 mt-0.5 shrink-0\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg>Full access for 15 days</li><li class=\"flex items-start gap-2.5 text-sm text-slate-300 font-light\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big w-4 h-4 text-emerald-400 mt-0.5 shrink-0\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg>Up to 2 doctors &amp; 50 patients</li><li class=\"flex items-start gap-2.5 text-sm text-slate-300 font-light\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big w-4 h-4 text-emerald-400 mt-0.5 shrink-0\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg>Appointments &amp; prescriptions</li><li class=\"flex items-start gap-2.5 text-sm text-slate-300 font-light\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big w-4 h-4 text-emerald-400 mt-0.5 shrink-0\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg>Email support</li></ul><a class=\"w-full flex items-center justify-center gap-2 text-sm font-semibold px-5 py-3 rounded-xl transition-all bg-white/5 text-white hover